DATABASE_URL=sqlite:///./skyassist.db
APP_NAME=SkyAssist API

# LLM: a direct provider, or a company gateway with an OpenAI-style API
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://quasarmarket.coforge.com/qag/llmrouter-api/v2
LLM_API_KEY=
LLM_API_KEY_HEADER=X-API-KEY

# RAG (0.20 was chosen with evals/run_eval.py)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_MIN_SCORE=0.20

# Protects flight create/update/delete and /rag/rebuild (send it as the X-Admin-Key header).
# Leave empty to disable those endpoints. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=